[Unit]
Description=XAUUSD Trading Bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/sanjay/xau_bot
ExecStart=/usr/bin/python3 /home/sanjay/xau_bot/main.py paper --feed websocket --log-level INFO
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xau-bot
Environment=PYTHONUNBUFFERED=1
Environment=TZ=UTC

# Watchdog
WatchdogSec=300

[Install]
WantedBy=multi-user.target
